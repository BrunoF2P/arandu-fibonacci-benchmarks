import io
import std.env as env

func fibFast(n: u64): u64 {
    if n == 0 {
        return 0
    }
    let mut a: u64 = 0
    let mut b: u64 = 1
    let mut bit: u64 = 64
    while bit > n {
        set bit = bit >> 1
    }
    while bit > 0 {
        let d = a * ((b << 1) - a)
        let e = a * a + b * b
        set a = d
        set b = e
        if (n & bit) != 0 {
            let c = a + b
            set a = b
            set b = c
        }
        set bit = bit >> 1
    }
    return a
}

func main(): int {
    let base: u64 = (env.argsLen() as u64) + 89
    let mut acc: u64 = 0
    let mut i: u64 = 0
    while i < 10000000 {
        let n = base + (i & 3)
        set acc = acc + fibFast(n)
        set i = i + 1
    }
    io.println("${acc}")
    return 0
}
